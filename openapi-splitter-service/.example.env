PORT=8000
NODE_ENV=development
# Версия API в URL: /api/{API_VERSION}/splitter/...
API_VERSION=v1
FILES_SERVICE_URL=http://files-service:8001
# Заголовок и секрет для обхода rate limit в files-service (тот же INTERNAL_SERVICE_SECRET что и в files-service .env).
# FILES_INTERNAL_SERVICE_HEADER=openapi-splitter
# INTERNAL_SERVICE_SECRET=your-shared-secret
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://redis:6379
# Ретраи Redis
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_RETRY_DELAY_MS=200
REDIS_RETRY_MAX_DELAY_MS=3000
RATE_LIMIT_MAX=45
RATE_LIMIT_WINDOW_SEC=60
