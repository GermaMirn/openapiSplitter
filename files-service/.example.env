PORT=8001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@db-files:5432/files_service
DB_HOST=db-files
DB_PORT=5432
DB_NAME=files_service
DB_USER=postgres
DB_PASSWORD=postgres
STORAGE_PATH=/app/storage
CORS_ORIGIN=*
REDIS_URL=redis://redis:6379
# Версия API в URL: /api/{API_VERSION}/files/...
API_VERSION=v1
# Ретраи Redis
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_RETRY_DELAY_MS=200
REDIS_RETRY_MAX_DELAY_MS=3000
# Ретраи подключения к PostgreSQL при старте
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_MS=1000
RATE_LIMIT_MAX=45
RATE_LIMIT_WINDOW_SEC=60
